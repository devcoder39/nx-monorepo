{
  // 🅰️ Entorno aislado para Angular + Nx + Mise
  "name": "🅰️ Angular + ⚡ Nx + 🛠️ Mise 🅰️ ",
  "service": "AngularNxMise",
  "dockerComposeFile": "./containers/compose.yaml",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
        "installZsh": true,
        "configureZshAsDefaultShell": true,
        "installOhMyZsh": true,
        "installOhMyZshConfig": true,
        "upgradePackages": true,
        "configureGpgWithGpgAgent": true
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
        "plugins": "zsh-autosuggestions zsh-syntax-highlighting",
        "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
        "moby": "false"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "projectMetadata": {
        "author": "@DevSoft Team",
        "repository": "git@github.com:devcoder39/.git",
        "version": "1.0.0",
        "license": "MIT",
        "environment": "Development"
    },
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "nrwl.angular-console",
        "dbaeumer.vscode-eslint",
        "hverlin.mise-vscode",
        "loiane.angular-extension-pack",
        "jdinhlife.gruvbox"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "workbench.iconTheme": "symbols",
        "workbench.colorTheme": "Gruvbox Dark Soft",
        "git.blame.editorDecoration.enabled": true,
        "git.blame.statusBarItem.enabled": true,
        "scm.experimental.showHistoryGraph": true,
        "editor.renderLineHighlight": "none",
        "editor.cursorSmoothCaretAnimation": "off",
        "workbench.colorCustomizations": {
            "git.blame.editorDecorationForeground": "#c7c7c788"
        },
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "git.autocrlf": "input",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.renderIndentGuides": true
      }
    }
  },
  "workspaceFolder": "/workspaces",
  // 🌐 Puertos típicos: 4200 (Angular) y 4211 (Nx Graph) 
  "forwardPorts": [4200, 4211],
  "portsAttributes": {
		"4200": { "label": "🅰️ Servidor Web Angular", "onAutoForward": "notify" },
		"4211": { "label": "🚀 Servidor Web Nx Graph", "onAutoForward": "notify" }
	},
  "postCreateCommand": "bash ./.devcontainer/scripts/post-create.sh",
  "remoteUser": "vscode"
}